# ═══════════════════════════════════════════════════════════════════════════
#  apps/api — Vercel project "apna-ghar-api"  (Root Directory: apps/api)
# ═══════════════════════════════════════════════════════════════════════════
#  TEMPLATE — committed. Every secret is blank on purpose.
#  Copy to .env for local use, and copy the KEYS into the Vercel project's
#  Settings → Environment Variables (Production scope), then REDEPLOY.
#  Vercel bakes env vars in at build time; saving one without redeploying
#  changes nothing.  Full reference: docs/api-env-vars.md
# ═══════════════════════════════════════════════════════════════════════════

# ── Database ────────────────────────────────────────────────────────────────
# ⚠️ DELIBERATELY COMMENTED OUT, NOT BLANK. The Prisma CLI auto-loads this file
# when you run anything from apps/api, so a Neon URL sitting here means a stray
# `prisma migrate reset` silently drops the LIVE database. That is why the real
# credentials live in apps/api/.env.neon and are passed in explicitly by
# scripts/deploy-db.ps1. Leave these commented; set them in Vercel only.
#
#   DATABASE_URL  = Neon POOLED host (contains "-pooler"), plus
#                   ?pgbouncer=true&connection_limit=1
#   DIRECT_URL    = Neon DIRECT host (no "-pooler"). Migrations only, but
#                   `prisma generate` fails if it is unset.
#
# DATABASE_URL=
# DIRECT_URL=

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
API_BASE_URL=http://localhost:3000
SHARE_BASE_URL=http://localhost:3002

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate a pair for local use and a DIFFERENT pair for Vercel — rotating
# either one invalidates every issued token and logs all users out, so set
# them once there and leave them alone.
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# ── OTP — this is what lets you log in without an SMS gateway ───────────────
# OTP_DEV_MODE=true makes the API return the code in its own HTTP response
# instead of sending an SMS, and the mobile app prefills it for you.
# ⚠️ It also means ANYONE CAN LOG IN AS ANYONE. Fine for testing, never for
# real agents. Turn it off and configure SMS_* before launch — the prefill
# disappears by itself when you do.
OTP_DEV_MODE=true
OTP_DEV_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Seeded accounts (prisma/seed.ts, only when NODE_ENV is unset/development):
#   agent  0300 1234567   basic plan, 3 free listings
#   admin  0300 9999999   for the admin panel
# Both use the OTP_DEV_CODE above.

# ── Maintenance schedule ────────────────────────────────────────────────────
# Shared secret for POST /api/maintenance/run, called by
# .github/workflows/api-cron.yml. Must match the CRON_SECRET repo secret in
# GitHub → Settings → Secrets and variables → Actions.
# Unset means the endpoint returns 401 — it fails closed on purpose.
CRON_SECRET=

# ── SMS ─────────────────────────────────────────────────────────────────────
# "console" just logs the code. Swap in a real aggregator with OTP_DEV_MODE=false.
SMS_PROVIDER=console
SMS_SENDER_ID=GHAR
SMS_API_KEY=

# ── Media: Cloudflare R2 ────────────────────────────────────────────────────
# Blank = image upload and playback 500. Everything else still works.
# dash.cloudflare.com → R2 → bucket ghar-media → Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ghar-media
R2_PUBLIC_BASE_URL=
MEDIA_SIGNED_URL_TTL_SECONDS=900

# ── Video: Cloudflare Stream ────────────────────────────────────────────────
# ⚠️ PAID PRODUCT ($5/mo per 1,000 minutes stored). Leave blank; video upload
# fails cleanly and nothing else is affected.
CF_STREAM_ACCOUNT_ID=
CF_STREAM_TOKEN=
CF_STREAM_WEBHOOK_SECRET=
VIDEO_MAX_DURATION_SECONDS=90
VIDEO_MAX_BYTES=104857600

# ── Billing (paisa — never floats. Rs 100 = 10000) ──────────────────────────
PLAN_BASIC_PRICE_PAISA=10000
PLAN_BASIC_INCLUDED_LISTINGS=3
PLAN_PREMIUM_PRICE_PAISA=100000
PLAN_PREMIUM_INCLUDED_LISTINGS=20
EXTRA_LISTING_FEE_PAISA=5000
BILLING_CYCLE_DAYS=30
GRACE_PERIOD_DAYS=7
DORMANT_AFTER_DAYS=90
MANUAL_PAYMENT_PROVISIONAL_HOURS=24

# ── Payments ────────────────────────────────────────────────────────────────
# The manual wallet rail just shows the agent a number to send money to, so
# these are display strings — placeholders are enough to exercise the flow.
PAYMENTS_MANUAL_ENABLED=true
MANUAL_EASYPAISA_NUMBER=
MANUAL_EASYPAISA_ACCOUNT_TITLE=
MANUAL_JAZZCASH_NUMBER=
MANUAL_JAZZCASH_ACCOUNT_TITLE=

# The direct JazzCash rail. Only read when JAZZCASH_ENABLED=true, so the
# blanks below are harmless while it is false.
JAZZCASH_ENABLED=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=
JAZZCASH_RETURN_URL=

# ── Optional ────────────────────────────────────────────────────────────────
SENTRY_DSN=
