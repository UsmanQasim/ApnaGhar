{
  "name": "ghar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:admin": "pnpm --dir apps/admin dev",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:share": "pnpm --dir apps/share dev",
    "dev:mobile": "pnpm --dir apps/mobile dev",
    "dev:all": "turbo run dev --filter=@ghar/api --filter=@ghar/admin --filter=@ghar/web --filter=@ghar/share --filter=@ghar/mobile",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "i18n:check": "node packages/i18n/scripts/check-parity.mjs && node packages/i18n/scripts/check-usage.mjs",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @ghar/api prisma migrate dev",
    "db:seed": "pnpm --filter @ghar/api seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
