prisma/dev.db
prisma/dev.db-journal
**/generated/

# Local runtime data
.cache/
.firebase/
.serverless/
.dynamodb/
.tern-port

# Miscellaneous generated files
*.tgz
*.zip
*.tar.gz
*.orig

# Optional package manager metadata
.pnp.*
.yarn/*
!.yarn/cache
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Local docs/build snapshots if they are generated only
# keep design references tracked intentionally
# docs/**/code.html is intentionally left in Git

# Native app generated metadata
**/android/app/build/
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/

# Storybook / docs tools
.storybook-static/

# Ignore all local screenshots/debug dumps
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.mp4
*.mov
*.avi
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.gif
!docs/**/*.webp
!docs/**/*.svg

# Ignore generated app assets if they are not source-controlled
# Leave real project assets tracked intentionally
apps/mobile/assets/*.png
apps/mobile/assets/*.jpg
apps/mobile/assets/*.jpeg
apps/mobile/assets/*.webp

# Keep local certificate / keystore files out
*.keystore
*.p12
*.pem
*.crt
*.key
