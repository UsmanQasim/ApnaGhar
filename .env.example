# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
SHARE_BASE_URL=http://localhost:3002

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ghar:ghar@localhost:5432/ghar?schema=public
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Dev only: when true, OTP is not sent by SMS and is returned in the API response.
OTP_DEV_MODE=true
OTP_DEV_CODE=123456

# ─── SMS (local Pakistani aggregator) ────────────────────────────────────────
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=GHAR

# ─── Media: Cloudflare R2 (S3 compatible) ────────────────────────────────────
R2_ENDPOINT=http://localhost:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=ghar
R2_SECRET_ACCESS_KEY=ghar12345
R2_BUCKET=ghar-media
R2_PUBLIC_BASE_URL=http://localhost:9000/ghar-media
MEDIA_SIGNED_URL_TTL_SECONDS=900

# ─── Video: Cloudflare Stream ────────────────────────────────────────────────
CF_STREAM_ACCOUNT_ID=
CF_STREAM_TOKEN=
CF_STREAM_WEBHOOK_SECRET=
VIDEO_MAX_DURATION_SECONDS=90
VIDEO_MAX_BYTES=104857600

# ─── Billing ─────────────────────────────────────────────────────────────────
# All amounts in PAISA (Rs 1 = 100 paisa). Never use floats.
PLAN_BASIC_PRICE_PAISA=10000
PLAN_BASIC_INCLUDED_LISTINGS=3
PLAN_PREMIUM_PRICE_PAISA=100000
PLAN_PREMIUM_INCLUDED_LISTINGS=20
EXTRA_LISTING_FEE_PAISA=5000
BILLING_CYCLE_DAYS=30
GRACE_PERIOD_DAYS=7
DORMANT_AFTER_DAYS=90
# Optimistic unblock window for unverified manual payments.
MANUAL_PAYMENT_PROVISIONAL_HOURS=24

# ─── Payments: manual rail (phase 1) ─────────────────────────────────────────
PAYMENTS_MANUAL_ENABLED=true
MANUAL_EASYPAISA_NUMBER=03xxxxxxxxx
MANUAL_EASYPAISA_ACCOUNT_TITLE=
MANUAL_JAZZCASH_NUMBER=03xxxxxxxxx
MANUAL_JAZZCASH_ACCOUNT_TITLE=

# ─── Payments: JazzCash direct API ───────────────────────────────────────────
JAZZCASH_ENABLED=false
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/ApplicationAPI/API/Payment/DoTransaction
JAZZCASH_RETURN_URL=http://localhost:3000/payments/jazzcash/return

# ─── Payments: Easypaisa direct API ──────────────────────────────────────────
EASYPAISA_ENABLED=false
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_BASE_URL=
EASYPAISA_RETURN_URL=http://localhost:3000/payments/easypaisa/return

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug
